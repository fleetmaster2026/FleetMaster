# Copy this file to ".env" in the same folder and fill in real values.
# The server will not send RTA reminder emails without this.

# Port the backend runs on (optional, defaults to 5000)
PORT=5000

# Gmail account used to send RTA reminder emails (server/Services/mailService.js)
# Use a Gmail "App Password", not your normal Gmail password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password

# Address that receives the one daily admin summary email (all sites combined)
RTA_ADMIN_EMAIL=admin@example.com

# Optional: override the cron schedule for the RTA reminder job.
# Default is Mon-Sat at 8:00 AM ("0 8 * * 1-6").
# RTA_CRON_TIME=0 8 * * 1-6

# Optional: timezone used by the cron scheduler (default Asia/Kolkata)
# TIMEZONE=Asia/Kolkata
